# Copy to .env for a fresh checkout, then replace these sample values as needed.
# Compose reads .env for container configuration; credentials are not image build args.
# This template is committed. Real .env files are ignored by Git and Docker builds.
POSTGRES_USER=sample_user
POSTGRES_PASSWORD=sample_password
POSTGRES_DB=sample_db
# Host ports; change these if another application already uses them.
POSTGRES_PORT=10052
BACKEND_PORT=10051
FRONTEND_PORT=10050

# PUBLIC frontend settings: compiled into browser assets in the normal build.
# api = real FastAPI/PostgreSQL data (default). demo = in-browser fixtures only.
VITE_DATA_MODE=api
VITE_API_BASE=/api

# Startup applies Alembic, then imports the read-only DuckDB patient snapshots.
# Repeated seeding preserves application edits and deliberate deletions.
MIGRATE_ON_STARTUP=true
SEED_ON_STARTUP=true

# JSON array for Vite outside Compose; the Compose frontend uses same-origin /api.
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
