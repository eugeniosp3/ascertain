# Optional for the API skeleton. /health and /docs work without a database.
APP_ENV=development
APP_NAME="Ascertain API"
DEMO_MODE=true
CORS_ORIGINS='["http://localhost:5173"]'
DB_CONNECT_TIMEOUT_SECONDS=3

# Local demo credentials only; infra supplies the real runtime configuration.
# DATABASE_URL=postgresql+psycopg://ascertain:ascertain@localhost:5432/ascertain
