# Optional native-development settings. /health and /docs work without a database.
APP_ENV=development
APP_NAME="Ascertain API"
DEMO_MODE=true
CORS_ORIGINS='["http://localhost:5173"]'
DB_CONNECT_TIMEOUT_SECONDS=3

# Patient summaries: a free keyless LLM (LLM7) with the deterministic template as fallback.
# SUMMARY_PROVIDER is llm or template (template never calls the network).
# LLM_MODEL gpt-oss:20b also works on LLM7. LLM_TIMEOUT_SECONDS is bounded to 1-60.
# SUMMARY_PROVIDER=llm
# LLM_BASE_URL=https://api.llm7.io/v1
# LLM_MODEL=gemma-3-27b
# LLM_TIMEOUT_SECONDS=10

# Local demo credentials only; infra supplies the real runtime configuration.
# DATABASE_URL=postgresql+psycopg://sample_user:sample_password@127.0.0.1:10052/sample_db
