// PostgreSQL application model. Source of truth: app/models.py and Alembic revision
// 20261120_0002. Names here match MODEL_CONTRACT.md. Patients-only scope.
Project ascertain_backend {
  database_type: 'PostgreSQL'
  Note: 'Patient dashboard model for patients_100.csv (100 patients, 76 fields) plus application users, clinical notes, note attachment links, discussion comments, comment-to-note links, per-user discussion read markers and seed markers. No prior-auth requests, payer workflows, document checklists or criteria.'
}

Table seed_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  dataset_key text [not null, unique, note: 'patients-<date>-<id> for patient datasets; fixtures use their own key.']
  dataset_date date [not null]
  source_hashes jsonb [not null, note: 'Source path -> SHA-256.']
  export_manifest jsonb [not null, note: 'Build/export document: versions, source file IDs, counts, validation.']
  row_counts jsonb [not null]
  completed_at timestamptz [not null, default: `now()`]
  Note: 'Completion marker committed in the same transaction as the imported rows. Restart never recreates deleted rows or overwrites edits.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  display_name varchar(120) [not null]
  display_role varchar(80) [note: 'Display label only (e.g. Physician); not a permission role.']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `display_name ~ '[^[:space:]]'` [name: 'users_display_name']
    `display_role IS NULL OR display_role ~ '[^[:space:]]'` [name: 'users_display_role']
    `updated_at >= created_at` [name: 'users_timestamps']
  }
  Note: 'Stable authors. Deactivate; never delete (author FKs restrict).'
}

Table patients {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Seeded: uuid5(ascertain:backend:patient:v1, source_patient_id). API: uuid4.']

  assigned_user_id uuid [note: 'Nullable workload assignment; not access control. Server-owned.']

  // Editable profile
  first_name varchar(100) [not null]
  middle_initial varchar(1)
  last_name varchar(100) [not null]
  date_of_birth date [not null, note: 'Current age is computed, never stored.']
  phone varchar(40) [note: 'Seeded from mobile, else home.']
  email varchar(254)
  address_line1 varchar(255)
  address_line2 varchar(255) [note: 'Absent from source; null when seeded.']
  city varchar(100)
  state varchar(2)
  postal_code varchar(10) [note: 'Text; from source zip.']
  blood_type varchar(3) [note: 'Null = unknown; absent from source.']
  status varchar(16) [not null, default: 'active', note: 'Application default; absent from source.']
  last_visit date [note: 'Seeded from pcp_last_visit_date (last PCP visit).']
  conditions jsonb [not null, default: `'[]'::jsonb`, note: 'Array of {code: string|null, label: string}.']
  allergies jsonb [not null, default: `'[]'::jsonb`, note: 'Array of strings.']
  allergy_status varchar(16) [not null, default: 'unknown']

  // Server-owned identifiers and read-only imported context
  mrn text [unique, note: 'Text; null for API-created patients.']
  source_patient_id text [unique, note: 'Original PT-#### key.']
  seed_run_id uuid
  source_lineage jsonb [note: 'SourceLineage: bronze_id, silver_id, source_row_number (+ export_id / source_file_id / transformation_version).']
  source_record jsonb [note: 'All 76 original strings. Deferred load; never in ordinary API responses.']
  profile_details jsonb [note: 'ProfileDetails sections: identity, contact, care_team, coverage, clinical, labs, social.']
  source_created_at timestamptz
  source_updated_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (last_name, first_name, id) [name: 'ix_patients_name']
    (status, id) [name: 'ix_patients_status']
    (last_visit, id) [name: 'ix_patients_last_visit']
    (date_of_birth, id) [name: 'ix_patients_date_of_birth']
    (assigned_user_id, id) [name: 'ix_patients_assigned_user_id']
  }
  checks {
    `first_name ~ '[^[:space:]]' AND last_name ~ '[^[:space:]]'` [name: 'patients_names']
    `status IN ('active', 'inactive')` [name: 'patients_status']
    `blood_type IS NULL OR blood_type IN ('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-')` [name: 'patients_blood_type']
    `allergy_status IN ('unknown', 'no_known', 'reported')` [name: 'patients_allergy_status']
    `jsonb_typeof(conditions) = 'array' AND jsonb_typeof(allergies) = 'array'` [name: 'patients_medical_arrays']
    `(allergy_status = 'reported') = (jsonb_array_length(allergies) > 0)` [name: 'patients_allergy_consistency']
    `((source_patient_id IS NULL AND seed_run_id IS NULL AND source_lineage IS NULL AND source_record IS NULL AND profile_details IS NULL AND source_created_at IS NULL AND source_updated_at IS NULL) OR (source_patient_id IS NOT NULL AND seed_run_id IS NOT NULL AND source_lineage IS NOT NULL AND source_record IS NOT NULL AND profile_details IS NOT NULL AND source_created_at IS NOT NULL AND source_updated_at IS NOT NULL)) AND (source_patient_id IS NULL OR (jsonb_typeof(source_lineage) = 'object' AND jsonb_typeof(source_record) = 'object' AND jsonb_typeof(profile_details) = 'object'))` [name: 'patients_source_provenance']
    `updated_at >= created_at` [name: 'patients_timestamps']
  }
}

Table notes {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  author_id uuid [not null]
  title varchar(80) [default: 'Clinical note', note: 'Null only on a tombstone.']
  timestamp timestamptz [not null, note: 'Client-supplied clinical time.']
  content text [note: 'Null only on a tombstone.']
  source_type varchar(12) [not null, default: 'manual']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  deleted_by_id uuid
  indexes {
    (id, patient_id) [unique, name: 'notes_id_patient_id_key']
    (patient_id, timestamp, id) [name: 'ix_notes_patient_timestamp']
    patient_id [name: 'ix_notes_active_patient', note: 'Partial: WHERE deleted_at IS NULL']
    author_id [name: 'ix_notes_author']
  }
  checks {
    `source_type IN ('manual', 'seed')` [name: 'notes_source_type']
    `(deleted_at IS NULL AND title IS NOT NULL AND title ~ '[^[:space:]]' AND content IS NOT NULL AND content ~ '[^[:space:]]' AND length(content) <= 20000) OR (deleted_at IS NOT NULL AND title IS NULL AND content IS NULL)` [name: 'notes_content_or_tombstone']
    `(deleted_at IS NULL) = (deleted_by_id IS NULL)` [name: 'notes_deletion_actor']
    `updated_at >= created_at` [name: 'notes_timestamps']
  }
  Note: 'Deletion keeps a contentless tombstone so comment links stay stable; lists, counts and summaries exclude it.'
}

Table note_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  note_id uuid [not null]
  added_by_id uuid [not null]
  display_name varchar(255) [not null]
  source_url text [not null, note: 'HTTPS, <= 2048 chars. External reference; never fetched or uploaded.']
  media_type varchar(100)
  source_description varchar(500)
  created_at timestamptz [not null, default: `now()`]
  indexes {
    note_id [name: 'ix_note_attachments_note']
  }
  checks {
    `display_name ~ '[^[:space:]]'` [name: 'note_attachments_display_name']
    `left(source_url, 8) = 'https://' AND length(source_url) <= 2048` [name: 'note_attachments_source_url']
  }
}

Table comments {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  author_id uuid [not null]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (id, patient_id) [unique, name: 'comments_id_patient_id_key']
    (patient_id, created_at, id) [name: 'ix_comments_patient_created']
    author_id [name: 'ix_comments_author']
  }
  checks {
    `body ~ '[^[:space:]]' AND length(body) <= 10000` [name: 'comments_body']
    `updated_at >= created_at` [name: 'comments_timestamps']
  }
  Note: 'Team discussion; never clinical summary input. Author-only edit/delete; physical delete.'
}

Table comment_note_links {
  comment_id uuid [not null]
  note_id uuid [not null]
  patient_id uuid [not null]
  indexes {
    (comment_id, note_id) [pk, name: 'comment_note_links_pkey']
    (note_id, patient_id) [name: 'ix_comment_note_links_note']
  }
  Note: 'Composite FKs guarantee comment and note belong to the same patient. Links to tombstoned notes remain.'
}

Table discussion_reads {
  user_id uuid [not null]
  patient_id uuid [not null]
  last_read_at timestamptz [not null, note: 'Creation-time cutoff; only ever advances (GREATEST).']
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, patient_id) [pk, name: 'discussion_reads_pkey']
    patient_id [name: 'ix_discussion_reads_patient']
  }
  Note: 'Unread = comments by other authors with created_at > last_read_at (missing row = none read).'
}

Ref patients_assigned_user_id_fkey: patients.assigned_user_id > users.id [delete: set null]
Ref patients_seed_run_id_fkey: patients.seed_run_id > seed_runs.id [delete: restrict]
Ref notes_patient_id_fkey: notes.patient_id > patients.id [delete: cascade]
Ref notes_author_id_fkey: notes.author_id > users.id [delete: restrict]
Ref notes_deleted_by_id_fkey: notes.deleted_by_id > users.id [delete: restrict]
Ref note_attachments_note_id_fkey: note_attachments.note_id > notes.id [delete: cascade]
Ref note_attachments_added_by_id_fkey: note_attachments.added_by_id > users.id [delete: restrict]
Ref comments_patient_id_fkey: comments.patient_id > patients.id [delete: cascade]
Ref comments_author_id_fkey: comments.author_id > users.id [delete: restrict]
Ref comment_note_links_comment_fkey: comment_note_links.(comment_id, patient_id) > comments.(id, patient_id) [delete: cascade]
Ref comment_note_links_note_fkey: comment_note_links.(note_id, patient_id) > notes.(id, patient_id) [delete: cascade]
Ref discussion_reads_user_id_fkey: discussion_reads.user_id > users.id [delete: cascade]
Ref discussion_reads_patient_id_fkey: discussion_reads.patient_id > patients.id [delete: cascade]
