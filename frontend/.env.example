# Public configuration: Vite embeds VITE_* values in the browser bundle.
# Explicit data mode: demo | api. The application defaults to demo when omitted.
VITE_DATA_MODE=demo
VITE_API_BASE=/api

# Server-only development proxy. /api is stripped before forwarding to FastAPI.
# Never prefix this with VITE_; it must not be exposed as browser configuration.
API_PROXY_TARGET=http://127.0.0.1:8000

# Local default. Set 0.0.0.0 for containers or access from another device.
DEV_SERVER_HOST=127.0.0.1

# Optional Playwright target; omit to start an isolated dev server on port 4174.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:4174
